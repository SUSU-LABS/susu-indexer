# susu-indexer — environment template
#
# Copy to `.env` for local runs. NEVER commit `.env`.
#
# SECURITY: every value here is server-only. The service-role key bypasses RLS
# and must never be exposed to a browser, returned in a response, or logged.
#
# In production these are set as Edge Function secrets, not as committed files:
#   supabase secrets set --env-file .env

# ---------------------------------------------------------------------------
# Supabase (server-only)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required to invoke the indexer function. Must be at least 32
# characters and must match the value stored in Vault for the cron schedule.
# Generate with: openssl rand -hex 32
INDEXER_TASK_SECRET=

# ---------------------------------------------------------------------------
# Stellar
# Mainnet is out of scope until the Mainnet readiness gate is passed.
# The passphrase must match STELLAR_NETWORK; the function rejects a mismatch.
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Public contract addresses (C... values are public).
# The group contracts and USDC SAC are added once deployed in Phase 2.
FACTORY_CONTRACT_ID=
USDC_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Indexing bounds
# ---------------------------------------------------------------------------

# Ledger the contracts were deployed at. A first run begins here.
# Set this to the Factory deployment ledger so indexing does not scan history.
INDEXER_START_LEDGER=1

# Maximum ledgers processed per invocation. Keeps each scheduled run within its
# execution budget; the next run resumes from the checkpoint.
INDEXER_MAX_LEDGER_RANGE=1000

# ---------------------------------------------------------------------------
# Safety switch. The indexer refuses to run against Mainnet unless this is
# "true", which requires explicit approval.
# ---------------------------------------------------------------------------
ALLOW_MAINNET=false
